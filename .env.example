# AI Game Lab — environment configuration
# Copy this file to `.env` and adjust the values.

# Secret key for session signing. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, local development):
DATABASE_URL=sqlite:///instance/app.db
#
# PostgreSQL (external database) — either set DATABASE_URL directly, or set the
# discrete POSTGRES_* variables below and the app builds the URL for you:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#   POSTGRES_USER=ai_game_lab
#   POSTGRES_PASSWORD=change-me
#   POSTGRES_HOST=db
#   POSTGRES_PORT=5432
#   POSTGRES_DB=ai_game_lab
#
# After changing the database, run:
#   flask --app run.py db upgrade
#   flask --app run.py seed

# ---------------------------------------------------------------------------
# Redis (async competition runs / task queue)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# When REDIS_URL is empty, competition runs execute synchronously.

# ---------------------------------------------------------------------------
# LLM providers (multi-provider, multi-model)
# ---------------------------------------------------------------------------
# LLM_PROVIDERS is a JSON list. Each provider has:
#   id        unique name (used in "provider:model" references)
#   type      "openai" (OpenAI-compatible; Ollama included) or "mock"
#   base_url  API base URL (for type "openai")
#   api_key   API key (Ollama ignores it; use any non-empty value)
#   models    list of model names offered by this provider
#
# The "mock" provider is always available offline.
#
# Example (Ollama + an external OpenAI-compatible service):
# LLM_PROVIDERS=[{"id":"ollama","type":"openai","base_url":"http://localhost:11434/v1","api_key":"ollama","models":["llama3.2","qwen2.5"]},{"id":"openai","type":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-...","models":["gpt-4o-mini","gpt-4o"]}]
LLM_PROVIDERS=

# Global default provider/model (fallback when a role or agent has no explicit
# model). Bare model names resolve against DEFAULT_PROVIDER.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=mock-model

# ---------------------------------------------------------------------------
# First-boot administrator (used by `flask --app run.py seed`)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# When true, the Docker entrypoint runs `flask seed` after migrations.
SEED_ON_START=false

# ---------------------------------------------------------------------------
# Game templates directory (normally leave unchanged)
# ---------------------------------------------------------------------------
# GAME_TEMPLATES_DIR=game_templates
